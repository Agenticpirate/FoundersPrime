// Utility functions for deal management
export function getDealsByCategory(category: string): Deal[] {
  const allDeals = getAllDeals()
  return allDeals.filter(deal => deal.category === category)
}

export function getFeaturedDeals(): Deal[] {
  const allDeals = getAllDeals()
  return allDeals.filter(deal => deal.featured)
}

export function getExpiringSoonDeals(): Deal[] {
  const thirtyDaysFromNow = new Date()
  thirtyDaysFromNow.setDate(thirtyDaysFromNow.getDate() + 30)
  
  const allDeals = getAllDeals()
  return allDeals.filter(deal => {
    if (!deal.expiryDate) return false
    return new Date(deal.expiryDate) <= thirtyDaysFromNow
  })
}

export function searchDeals(query: string): Deal[] {
  const searchTerm = query.toLowerCase()
  const allDeals = getAllDeals()
  return allDeals.filter(deal => 
    deal.title.toLowerCase().includes(searchTerm) ||
    deal.description.toLowerCase().includes(searchTerm) ||
    deal.provider.toLowerCase().includes(searchTerm) ||
    deal.tags.some(tag => tag.toLowerCase().includes(searchTerm))
  )
}

export function getAllDeals(): Deal[] {
  const storedDeals = getDealsFromStorage()
  // If no stored deals, return sample deals as fallback
  return storedDeals.length > 0 ? storedDeals : sampleDeals
}

export function addDeals(newDeals: Deal[]): Deal[] {
  return addDealsToStorage(newDeals)
}

export function getDealStats(): DealStats {
  const allDeals = getAllDeals()
  const totalValue = dealCategories.reduce((sum, category) => {
    const value = category.totalValue.replace(/[^0-9]/g, '')
    return sum + (parseInt(value) || 0)
  }, 0)

  return {
    totalDeals: allDeals.length,
    totalValue: `${totalValue}K+`,
    categoriesCount: dealCategories.length,
    activeDeals: allDeals.filter(deal => deal.status === 'active').length,
    expiringSoon: getExpiringSoonDeals().length,
    recentlyAdded: allDeals.filter(deal => {
      const weekAgo = new Date()
      weekAgo.setDate(weekAgo.getDate() - 7)
      return new Date(deal.createdAt) >= weekAgo
    }).length
  }
}

export function getFeaturedDeals(): Deal[] {
  return sampleDeals.filter(deal => deal.featured)
}

export function getExpiringSoonDeals(): Deal[] {
  const thirtyDaysFromNow = new Date()
  thirtyDaysFromNow.setDate(thirtyDaysFromNow.getDate() + 30)
  
  return sampleDeals.filter(deal => {
    if (!deal.expiryDate) return false
    return new Date(deal.expiryDate) <= thirtyDaysFromNow
  })
}

export function searchDeals(query: string): Deal[] {
  const searchTerm = query.toLowerCase()
  return sampleDeals.filter(deal => 
    deal.title.toLowerCase().includes(searchTerm) ||
    deal.description.toLowerCase().includes(searchTerm) ||
    deal.provider.toLowerCase().includes(searchTerm) ||
    deal.tags.some(tag => tag.toLowerCase().includes(searchTerm))
  )
}

export function getDealStats(): DealStats {
  const totalValue = dealCategories.reduce((sum, category) => {
    const value = category.totalValue.replace(/[^0-9]/g, '')
    return sum + (parseInt(value) || 0)
  }, 0)

  return {
    totalDeals: sampleDeals.length,
    totalValue: `$${totalValue}K+`,
    categoriesCount: dealCategories.length,
    activeDeals: sampleDeals.filter(deal => deal.status === 'active').length,
    expiringSoon: getExpiringSoonDeals().length,
    recentlyAdded: sampleDeals.filter(deal => {
      const weekAgo = new Date()
      weekAgo.setDate(weekAgo.getDate() - 7)
      return new Date(deal.createdAt) >= weekAgo
    }).length
  }
}

// JoinSecret integration utilities
export interface JoinSecretDeal {
  id: string
  title: string
  company: string
  category: string
  description: string
  value: string
  link: string
  requirements: string[]
  expires?: string
}

export function convertJoinSecretDeal(joinSecretDeal: JoinSecretDeal): Deal {
  return {
    id: `js-${joinSecretDeal.id}`,
    slug: joinSecretDeal.title.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
    title: joinSecretDeal.title,
    provider: joinSecretDeal.company,
    category: mapJoinSecretCategory(joinSecretDeal.category),
    description: joinSecretDeal.description,
    shortDescription: joinSecretDeal.description.substring(0, 120) + '...',
    value: joinSecretDeal.value,
    eligibility: joinSecretDeal.requirements,
    requirements: joinSecretDeal.requirements,
    applicationProcess: ['Visit provider website', 'Complete application', 'Await approval'],
    tags: [joinSecretDeal.category, joinSecretDeal.company],
    status: 'active' as const,
    expiryDate: joinSecretDeal.expires,
    applicationUrl: joinSecretDeal.link,
    providerWebsite: joinSecretDeal.link,
    featured: false,
    verified: true,
    difficulty: 'medium' as const,
    timeToApply: '15 minutes',
    lastUpdated: new Date().toISOString().split('T')[0],
    createdAt: new Date().toISOString().split('T')[0],
    updatedAt: new Date().toISOString().split('T')[0],
    joinSecretId: joinSecretDeal.id,
    joinSecretUrl: joinSecretDeal.link,
    sourceVerified: true,
    dataSource: 'joinsecret' as const
  }
}

function mapJoinSecretCategory(category: string): string {
  const categoryMap: Record<string, string> = {
    'saas': 'saas-discounts',
    'cloud': 'cloud-credits',
    'grants': 'grants',
    'accelerator': 'accelerators',
    'incubator': 'incubators',
    'advertising': 'ad-credits',
    'ai': 'ai',
    'marketing': 'marketing',
    'development': 'development',
    'finance': 'finance',
    'business': 'business'
  }
  
  return categoryMap[category.toLowerCase()] || 'saas-discounts'
}

// New utility functions for enhanced category system
export function getAllCategories(): DealCategory[] {
  return dealCategories
}

export function getFeaturedCategories(): DealCategory[] {
  return dealCategories.filter(category => category.featured)
}

export function getCategoryBySlug(slug: string): DealCategory | undefined {
  return dealCategories.find(category => category.slug === slug)
}

export function getSubcategoriesByCategory(categoryId: string): DealSubcategory[] {
  const category = dealCategories.find(cat => cat.id === categoryId)
  return category?.subcategories || []
}

export function getDealsBySubcategory(subcategory: string): Deal[] {
  return sampleDeals.filter(deal => deal.subcategory === subcategory)
}

export function searchDealsByCategory(category: string, subcategory?: string): Deal[] {
  let filtered = sampleDeals.filter(deal => deal.category === category)
  if (subcategory) {
    filtered = filtered.filter(deal => deal.subcategory === subcategory)
  }
  return filtered
}