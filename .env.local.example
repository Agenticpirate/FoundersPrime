# ===========================================
# SUPABASE CONFIGURATION (Required for Auth)
# ===========================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# APPLICATION SETTINGS
# ===========================================
# Base URL for the application (used for OAuth redirects)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ===========================================
# DATABASE CONFIGURATION (Optional)
# ===========================================
# Choose your database type: 'supabase' or 'mongodb'
DATABASE_TYPE=supabase

# MongoDB (Alternative to Supabase for deals storage)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/foundersprime?retryWrites=true&w=majority

# ===========================================
# ADMIN CONFIGURATION
# ===========================================
# Simple admin password for solo admin access
ADMIN_PASSWORD=your-secure-admin-password

# ===========================================
# OAUTH PROVIDERS (Configure in Supabase Dashboard)
# ===========================================
# To enable Google/GitHub OAuth:
# 1. Go to Supabase Dashboard > Authentication > Providers
# 2. Enable Google and/or GitHub
# 3. Add your OAuth credentials from Google Cloud Console / GitHub Developer Settings
# 4. Set the redirect URL to: https://your-project.supabase.co/auth/v1/callback
