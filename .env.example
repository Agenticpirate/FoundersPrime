# Copy to .env.local and fill in real values, then restart: npm run dev
# Never commit .env.local

# Supabase (required for local login / signup / OAuth)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Optional server-only
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cloudflare Turnstile (optional on localhost; required on production)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# App URL
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# Dodo Payments (required for checkout and signed payment webhooks)
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# DODO_PAYMENTS_WEBHOOK_SECRET=
# DODO_PRODUCT_NEXTFOUNDER_YEARLY=
# DODO_PRODUCT_FOUNDER_YEARLY=
# DODO_PRODUCT_LEGEND_LIFETIME=
# DODO_PRODUCT_FEATURED_WEEKLY=
# DODO_PRODUCT_FEATURED_LISTING=

# Resend lifecycle and automated email delivery
# RESEND_API_KEY=re_...
# RESEND_FROM_NAME=FoundersPrime
# RESEND_FROM_EMAIL=deals@foundersprime.com
# RESEND_REPLY_TO=support@foundersprime.com

# Cloudflare API (optional — only for automation)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_NAME=foundersprime.com
